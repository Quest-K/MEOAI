<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cycle Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07090d;--s1:#0d1018;--s2:#111520;--s3:#171c28;
  --b1:#1c2130;--b2:#242b3c;--b3:#2e3850;
  --text:#dde4f0;--sub:#8896b0;--muted:#3d4a60;
  --green:#00e5a0;--g2:rgba(0,229,160,.10);--g3:rgba(0,229,160,.22);
  --yellow:#f5c518;--y2:rgba(245,197,24,.10);--y3:rgba(245,197,24,.22);
  --orange:#ff8c42;--o2:rgba(255,140,66,.10);--o3:rgba(255,140,66,.22);
  --red:#ff4d6d;--r2:rgba(255,77,109,.10);--r3:rgba(255,77,109,.22);
  --blue:#4d9fff;--bl2:rgba(77,159,255,.10);--bl3:rgba(77,159,255,.22);
  --purple:#a78bfa;--p2:rgba(167,139,250,.10);--p3:rgba(167,139,250,.22);
  --cyan:#22d3ee;--c2:rgba(34,211,238,.10);--c3:rgba(34,211,238,.22);
  --mono:'JetBrains Mono',monospace;--sans:'Syne',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:var(--mono);font-size:12px;}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--b2);border-radius:2px;}

/* HEADER */
.header{display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:54px;border-bottom:1px solid var(--b1);background:var(--s1);position:sticky;top:0;z-index:100;gap:12px;}
.logo{font-family:var(--sans);font-size:17px;font-weight:800;letter-spacing:-.4px;display:flex;align-items:center;gap:8px;}
.logo-tag{font-size:9px;font-family:var(--mono);font-weight:700;padding:2px 7px;border-radius:3px;background:var(--yellow);color:#000;letter-spacing:1px;}
.search-wrap{flex:1;max-width:480px;display:flex;gap:8px;}
.sym-input{flex:1;height:34px;padding:0 14px;background:var(--s2);border:1px solid var(--b2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.5px;outline:none;transition:border-color .15s;text-transform:uppercase;}
.sym-input::placeholder{color:var(--muted);text-transform:none;font-weight:400;}
.sym-input:focus{border-color:var(--yellow);}
.btn-analyze{height:34px;padding:0 18px;background:var(--yellow);color:#000;border:none;border-radius:6px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.5px;cursor:pointer;transition:all .15s;white-space:nowrap;}
.btn-analyze:hover{opacity:.85;transform:translateY(-1px);}
.btn-analyze:disabled{opacity:.35;cursor:not-allowed;transform:none;}
.header-right{display:flex;align-items:center;gap:8px;flex-shrink:0;}
.dot{width:6px;height:6px;border-radius:50%;background:var(--muted);flex-shrink:0;}
.dot.loading{background:var(--yellow);box-shadow:0 0 6px var(--yellow);animation:blink .6s infinite;}
.dot.done{background:var(--green);box-shadow:0 0 6px var(--green);}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.2;}}
.status-txt{font-size:10px;color:var(--sub);}

/* MAIN */
.main{max-width:1100px;margin:0 auto;padding:28px 24px 60px;}

/* EMPTY */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;gap:12px;}
.empty-icon{font-size:36px;opacity:.25;}
.empty-title{font-family:var(--sans);font-size:16px;color:var(--b3);}
.empty-sub{font-size:11px;color:var(--muted);text-align:center;line-height:1.8;}

/* RESULT */
.result{display:none;flex-direction:column;gap:20px;}
.result.show{display:flex;}

/* SYM HEADER */
.sym-header{display:flex;align-items:center;gap:14px;padding:16px 20px;background:var(--s1);border:1px solid var(--b1);border-radius:10px;flex-wrap:wrap;}
.sym-name{font-family:var(--sans);font-size:22px;font-weight:800;}
.sym-price{font-family:var(--sans);font-size:20px;font-weight:700;color:var(--yellow);}
.sym-chg{font-size:12px;font-weight:600;}
.sym-chg.up{color:var(--green);}
.sym-chg.dn{color:var(--red);}
.sym-stats{display:flex;gap:0;margin-left:auto;border:1px solid var(--b1);border-radius:7px;overflow:hidden;}
.sym-stat{padding:8px 16px;border-right:1px solid var(--b1);}
.sym-stat:last-child{border-right:none;}
.ss-l{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;}
.ss-v{font-size:13px;font-weight:600;}

/* PIPELINE */
.pipeline{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
.stage-card{background:var(--s1);border:1px solid var(--b1);border-radius:8px;padding:12px 8px;text-align:center;position:relative;overflow:hidden;transition:all .15s;}
.stage-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--b2);}
.stage-card.current{border-color:var(--sc,var(--yellow));box-shadow:0 0 16px var(--sg,rgba(245,197,24,.15));}
.stage-card.current::before{background:var(--sc,var(--yellow));}
.stage-card.past{opacity:.4;}
.stage-card.future{opacity:.25;}
.stage-num{font-size:9px;color:var(--muted);letter-spacing:.5px;margin-bottom:5px;}
.stage-icon{font-size:18px;margin-bottom:5px;}
.stage-name{font-family:var(--sans);font-size:10px;font-weight:700;color:var(--sub);line-height:1.3;}
.stage-card.current .stage-name{color:var(--text);}
.now-badge{position:absolute;top:5px;right:5px;font-size:8px;font-weight:700;padding:1px 5px;border-radius:2px;background:var(--sc,var(--yellow));color:#000;letter-spacing:.5px;}

/* GRID */
.analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}

/* PANEL */
.panel{background:var(--s1);border:1px solid var(--b1);border-radius:10px;overflow:hidden;}
.panel-head{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--b1);background:var(--s2);}
.panel-title{font-family:var(--sans);font-size:13px;font-weight:700;}
.panel-sub{font-size:10px;color:var(--muted);margin-left:auto;}
.panel-body{padding:14px 16px;}

/* STAGE BADGE */
.stage-badge-lg{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:6px;font-family:var(--sans);font-size:13px;font-weight:700;border:1px solid transparent;margin-bottom:12px;}
.conf-wrap{display:flex;align-items:center;gap:8px;margin-bottom:14px;}
.conf-track{flex:1;height:4px;background:var(--b2);border-radius:2px;overflow:hidden;}
.conf-fill{height:100%;border-radius:2px;transition:width .5s;}
.conf-pct{font-size:11px;font-weight:600;min-width:34px;text-align:right;}

/* SIGNALS */
.signal-list{display:flex;flex-direction:column;gap:5px;}
.sig{display:flex;align-items:flex-start;gap:8px;padding:8px 10px;border-radius:6px;background:var(--s2);border:1px solid var(--b1);}
.sig.ok{border-color:var(--g3);}
.sig.bad{border-color:var(--r3);}
.sig.warn{border-color:var(--y3);}
.sig.info{border-color:var(--bl3);}
.sig-ic{font-size:11px;flex-shrink:0;margin-top:1px;}
.sig-tx{font-size:11px;line-height:1.5;color:var(--sub);}
.sig-tx strong{color:var(--text);}

/* GAUGES */
.gauge-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.gauge-lbl{font-size:10px;color:var(--sub);width:100px;flex-shrink:0;}
.gauge-track{flex:1;height:5px;background:var(--b2);border-radius:3px;overflow:hidden;}
.gauge-fill{height:100%;border-radius:3px;}
.gauge-val{font-size:10px;font-weight:600;min-width:40px;text-align:right;}
.mini-grid{margin-top:14px;display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.mini-cell{padding:7px 10px;background:var(--s2);border-radius:5px;border:1px solid var(--b1);}
.mini-lbl{font-size:9px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.4px;}
.mini-val{font-size:11px;font-weight:600;}

/* LEVELS */
.level-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--b1);}
.level-row:last-child{border-bottom:none;}
.level-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.level-lbl{font-size:10px;color:var(--sub);width:120px;flex-shrink:0;}
.level-px{font-size:13px;font-weight:600;min-width:70px;}
.level-desc{font-size:10px;color:var(--muted);flex:1;}
.level-dist{font-size:10px;font-weight:600;margin-left:auto;white-space:nowrap;}
.level-dist.up{color:var(--green);}
.level-dist.dn{color:var(--red);}

/* PROFIT */
.profit-table{width:100%;border-collapse:collapse;}
.profit-table th{padding:8px 10px;text-align:left;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid var(--b1);}
.profit-table td{padding:9px 10px;border-bottom:1px solid var(--b1);font-size:11px;}
.profit-table tr:last-child td{border-bottom:none;}
.profit-table tbody tr:hover td{background:var(--s2);}
.mult{font-weight:700;}
.mx3{color:var(--yellow);}
.mx5{color:var(--orange);}
.mx10{color:var(--red);}

/* NEXT */
.next-box{border:1px solid var(--b2);border-radius:8px;overflow:hidden;margin:14px 16px 16px;}
.next-row{display:flex;align-items:flex-start;gap:12px;padding:11px 14px;border-bottom:1px solid var(--b1);}
.next-row:last-child{border-bottom:none;}
.next-lbl{font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;letter-spacing:.5px;flex-shrink:0;margin-top:1px;}
.nl-bull{background:var(--g2);color:var(--green);border:1px solid var(--g3);}
.nl-bear{background:var(--r2);color:var(--red);border:1px solid var(--r3);}
.nl-watch{background:var(--y2);color:var(--yellow);border:1px solid var(--y3);}
.next-tx{font-size:11px;line-height:1.6;color:var(--sub);}
.next-tx strong{color:var(--text);}

/* DESC BOX */
.desc-box{background:var(--s2);border:1px solid var(--b1);border-radius:7px;padding:12px 14px;font-size:11px;line-height:1.8;color:var(--sub);margin-top:12px;}
.desc-box strong{color:var(--text);}

@media(max-width:700px){
  .header{flex-wrap:wrap;height:auto;padding:10px 16px;gap:8px;}
  .search-wrap{width:100%;max-width:100%;}
  .pipeline{grid-template-columns:repeat(4,1fr);}
  .analysis-grid{grid-template-columns:1fr;}
  .sym-stats{width:100%;margin-left:0;}
  .main{padding:16px 12px 40px;}
}
</style>
</head>
<body>

<header class="header">
  <div class="logo">
    Cycle<span style="color:var(--sub);font-weight:400">lens</span>
    <span class="logo-tag">ANALYZER</span>
  </div>
  <div class="search-wrap">
    <input class="sym-input" id="symInput" type="text" placeholder="심볼 입력 예) BTCUSDT  DAOUSDT  SOLUSDT" maxlength="20">
    <button class="btn-analyze" id="analyzeBtn" onclick="analyze()">분석</button>
  </div>
  <div class="header-right">
    <div class="dot" id="dot"></div>
    <span class="status-txt" id="statusTxt">대기</span>
  </div>
</header>

<div class="main">
  <div class="empty" id="emptyState">
    <div class="empty-icon">🔬</div>
    <div class="empty-title">세력 사이클 분석기</div>
    <div class="empty-sub">
      심볼을 입력하면 일봉 200개 기준으로<br>
      현재 매집 → 상승 → 분배 중 어느 단계인지 분석합니다<br><br>
      <span style="color:var(--b3)">BTCUSDT · ETHUSDT · DAOUSDT · SOLUSDT 등</span>
    </div>
  </div>

  <div class="result" id="result">
    <div id="symHeader" class="sym-header"></div>
    <div id="pipeline" class="pipeline"></div>
    <div id="mainGrid" class="analysis-grid"></div>
    <div id="levelPanel" class="panel"></div>
    <div id="profitPanel" class="panel"></div>
    <div id="nextPanel" class="panel"></div>
  </div>
</div>

<script>
const $=id=>document.getElementById(id);

const STAGES=[
  {num:1,icon:'🕳️',name:'침묵 매집',    color:'#4d9fff',glow:'rgba(77,159,255,.18)'},
  {num:2,icon:'🪤', name:'테스트 흔들기',color:'#a78bfa',glow:'rgba(167,139,250,.18)'},
  {num:3,icon:'🚀', name:'1차 상승',     color:'#f5c518',glow:'rgba(245,197,24,.18)'},
  {num:4,icon:'🔄', name:'조정 재매집',  color:'#22d3ee',glow:'rgba(34,211,238,.18)'},
  {num:5,icon:'⚡', name:'본 상승',      color:'#00e5a0',glow:'rgba(0,229,160,.18)'},
  {num:6,icon:'🏔️', name:'분배 클라이맥스',color:'#ff8c42',glow:'rgba(255,140,66,.18)'},
  {num:7,icon:'💀', name:'하락 덤핑',    color:'#ff4d6d',glow:'rgba(255,77,109,.18)'},
];

// ── FORMAT ──
function fp(p,d=2){
  if(p===null||p===undefined||isNaN(p))return'—';
  if(p===0)return'0';
  if(p>=10000)return p.toLocaleString('en',{maximumFractionDigits:0});
  if(p>=1)return p.toFixed(d);
  if(p>=0.01)return p.toFixed(4);
  return p.toFixed(6);
}
function fPct(p){if(p===null||isNaN(p))return'—';return(p>=0?'+':'')+p.toFixed(1)+'%';}
function fVol(v){if(!v||isNaN(v))return'—';if(v>=1e9)return(v/1e9).toFixed(2)+'B';if(v>=1e6)return(v/1e6).toFixed(2)+'M';if(v>=1e3)return(v/1e3).toFixed(1)+'K';return v.toFixed(0);}

// ── API ──
async function fetchKlines(sym,interval,limit){
  const r=await fetch(`https://fapi.binance.com/fapi/v1/klines?symbol=${sym}&interval=${interval}&limit=${limit}`);
  if(!r.ok)throw new Error(`${sym} 데이터를 가져올 수 없습니다. USDT 선물 심볼인지 확인해주세요.`);
  return r.json();
}
async function fetchTicker(sym){
  const r=await fetch(`https://fapi.binance.com/fapi/v1/ticker/24hr?symbol=${sym}`);
  if(!r.ok)throw new Error('ticker 실패');
  return r.json();
}
async function fetchOI(sym){
  try{
    const r=await fetch(`https://fapi.binance.com/fapi/v1/openInterest?symbol=${sym}`);
    if(!r.ok)return null;
    return parseFloat((await r.json()).openInterest);
  }catch{return null;}
}

// ── INDICATORS ──
function calcMA(arr,p){
  if(!arr||arr.length<p)return null;
  return arr.slice(-p).reduce((a,b)=>a+b,0)/p;
}
function calcBB(arr,p=20,m=2){
  if(!arr||arr.length<p)return null;
  const sl=arr.slice(-p);
  const mean=sl.reduce((a,b)=>a+b,0)/p;
  const std=Math.sqrt(sl.reduce((a,b)=>a+(b-mean)**2,0)/p);
  return{upper:mean+m*std,lower:mean-m*std,mid:mean};
}
function calcRSI(closes,p=14){
  if(!closes||closes.length<p+1)return null;
  let g=0,l=0;
  for(let i=closes.length-p;i<closes.length;i++){
    const d=closes[i]-closes[i-1];
    if(d>0)g+=d;else l-=d;
  }
  const rs=(g/p)/((l/p)||0.001);
  return 100-100/(1+rs);
}

// ── STAGE DETECTION ──
function detectStage(klines){
  const len=klines.length;
  const opens  =klines.map(k=>parseFloat(k[1]));
  const highs  =klines.map(k=>parseFloat(k[2]));
  const lows   =klines.map(k=>parseFloat(k[3]));
  const closes =klines.map(k=>parseFloat(k[4]));
  const vols   =klines.map(k=>parseFloat(k[5]));
  const cur=closes[len-1];

  const ma5  =calcMA(closes,5);
  const ma10 =calcMA(closes,10);
  const ma20 =calcMA(closes,20);
  const ma60 =calcMA(closes,60);
  const ma120=calcMA(closes,120);

  const isGolden=!!(ma5&&ma20&&ma60&&ma120&&ma5>ma20&&ma20>ma60&&ma60>ma120);
  const isDead  =!!(ma5&&ma20&&ma60&&ma120&&ma5<ma20&&ma20<ma60&&ma60<ma120);

  const bb=calcBB(closes,20,2);
  const bbW=bb&&bb.mid>0?(bb.upper-bb.lower)/bb.mid*100:0;
  const bbSqueezing=bbW<8;
  const aboveBBUpper=!!(bb&&cur>bb.upper);
  const belowBBLower=!!(bb&&cur<bb.lower);
  const nearBBLower =!!(bb&&!belowBBLower&&cur<bb.lower*1.03);

  const rsi=calcRSI(closes,14);

  const recentVols=vols.slice(-20);
  const avgVol20=recentVols.reduce((a,b)=>a+b,0)/recentVols.length||1;
  const lastVol=vols[len-1];
  const volRatio=lastVol/avgVol20;

  let upVolSum=0,dnVolSum=0;
  for(let i=len-20;i<len;i++){
    if(closes[i]>opens[i])upVolSum+=vols[i];
    else dnVolSum+=vols[i];
  }
  const volBias=upVolSum/(dnVolSum||1);

  const vol10last=vols.slice(-10);
  const volTrend=vol10last[9]-vol10last[0];

  const high60=Math.max(...highs.slice(-60));
  const low60 =Math.min(...lows.slice(-60));
  const range60=high60-low60||1;
  const posInRange=(cur-low60)/range60*100;
  const fromLow=low60>0?(cur-low60)/low60*100:0;
  const fromHigh=high60>0?(high60-cur)/high60*100:0;

  // 스코어링
  const scores=[0,0,0,0,0,0,0];

  // 1단계: 침묵 매집
  if(posInRange<30)           scores[0]+=25;
  if(bbSqueezing)             scores[0]+=20;
  if(rsi&&rsi<45)             scores[0]+=15;
  if(fromHigh>50)             scores[0]+=15;
  if(volBias>0.85&&volBias<1.3)scores[0]+=15;
  if(volRatio<1.2)            scores[0]+=10;

  // 2단계: 테스트/흔들기
  if(posInRange<25)              scores[1]+=20;
  if(belowBBLower||nearBBLower)  scores[1]+=25;
  if(rsi&&rsi<40)                scores[1]+=20;
  if(volRatio>1.5&&volTrend<0)   scores[1]+=20;
  if(fromHigh>40)                scores[1]+=15;

  // 3단계: 1차 상승
  if(posInRange>30&&posInRange<65) scores[2]+=15;
  if(aboveBBUpper)                 scores[2]+=20;
  if(volRatio>2)                   scores[2]+=25;
  if(rsi&&rsi>55&&rsi<75)          scores[2]+=15;
  if(volBias>1.3)                  scores[2]+=15;
  if(fromLow>20&&fromLow<80)       scores[2]+=10;

  // 4단계: 조정/재매집
  if(posInRange>30&&posInRange<60) scores[3]+=15;
  if(bbSqueezing)                  scores[3]+=20;
  if(volRatio<0.8)                 scores[3]+=25;
  if(rsi&&rsi>40&&rsi<60)          scores[3]+=20;
  if(fromLow>15&&fromHigh>20)      scores[3]+=15;
  if(volBias>1.0)                  scores[3]+=5;

  // 5단계: 본상승
  if(isGolden)                     scores[4]+=30;
  if(aboveBBUpper)                 scores[4]+=20;
  if(volRatio>1.5)                 scores[4]+=15;
  if(rsi&&rsi>60&&rsi<85)          scores[4]+=20;
  if(posInRange>60)                scores[4]+=15;

  // 6단계: 분배
  if(posInRange>75)                scores[5]+=25;
  if(rsi&&rsi>75)                  scores[5]+=25;
  if(volRatio>2.5)                 scores[5]+=20;
  if(volBias<0.9)                  scores[5]+=15;
  if(fromHigh<15)                  scores[5]+=15;

  // 7단계: 하락
  if(isDead)                       scores[6]+=30;
  if(belowBBLower)                 scores[6]+=20;
  if(rsi&&rsi<35)                  scores[6]+=15;
  if(posInRange<20)                scores[6]+=15;
  if(volBias<0.85)                 scores[6]+=10;
  if(fromHigh>60)                  scores[6]+=10;

  const total=scores.reduce((a,b)=>a+b,0)||1;
  const stageIdx=scores.indexOf(Math.max(...scores));
  const confidence=Math.round(scores[stageIdx]/total*100);

  // 신호
  const signals=[];
  if(isGolden)       signals.push({t:'ok',  tx:'MA <strong>정배열</strong> — 5·20·60·120 순서 정렬'});
  if(isDead)         signals.push({t:'bad', tx:'MA <strong>역배열</strong> — 하락 추세 구조'});
  if(aboveBBUpper)   signals.push({t:'ok',  tx:'볼린저밴드 <strong>상단 돌파</strong> — 강한 상승 압력'});
  if(belowBBLower)   signals.push({t:'bad', tx:'볼린저밴드 <strong>하단 이탈</strong> — 과매도/하락 추세'});
  if(nearBBLower)    signals.push({t:'warn',tx:'볼린저밴드 <strong>하단 근접</strong> — 지지 테스트 중'});
  if(bbSqueezing)    signals.push({t:'info',tx:`볼린저밴드 <strong>수축</strong> (밴드폭 ${bbW.toFixed(1)}%) — 에너지 응축`});
  if(volRatio>2)     signals.push({t:'ok',  tx:`거래량 평균 <strong>${volRatio.toFixed(1)}배</strong> — 강한 세력 개입 신호`});
  if(volRatio<0.6)   signals.push({t:'info',tx:`거래량 평균 <strong>${volRatio.toFixed(1)}배</strong> — 거래량 극도 감소`});
  if(volBias>1.4)    signals.push({t:'ok',  tx:`상승봉 거래량 우위 <strong>${volBias.toFixed(2)}배</strong> — 매집 구조`});
  if(volBias<0.75)   signals.push({t:'bad', tx:`하락봉 거래량 우위 — <strong>분배 구조</strong> 의심`});
  if(rsi!==null)     signals.push({t:rsi>75?'bad':rsi<35?'warn':'info',tx:`RSI <strong>${rsi.toFixed(1)}</strong> — ${rsi>75?'과매수 경고':rsi<35?'과매도 (반등 주시)':rsi>55?'상승 구간':'중립'}`});
  signals.push({t:'info',tx:`60일 저점 대비 <strong>+${fromLow.toFixed(1)}%</strong> / 고점 대비 <strong>-${fromHigh.toFixed(1)}%</strong>`});

  return{
    stageIdx,confidence,signals,
    ind:{
      ma5,ma10,ma20,ma60,ma120,bb,rsi,
      volRatio,volBias,bbW,bbSqueezing,
      isGolden,isDead,
      aboveBBUpper,belowBBLower,nearBBLower,
      posInRange,fromLow,fromHigh
    },
    price:{cur,high60,low60,avgVol20,lastVol}
  };
}

// ── 평단가 추정 ──
function estimateCost(klines){
  const highs =klines.map(k=>parseFloat(k[2]));
  const lows  =klines.map(k=>parseFloat(k[3]));
  const closes=klines.map(k=>parseFloat(k[4]));
  const vols  =klines.map(k=>parseFloat(k[5]));
  const len=klines.length;

  const sortedLows=[...lows].sort((a,b)=>a-b);
  const low30pct=sortedLows[Math.floor(sortedLows.length*0.3)];

  let vwapNum=0,vwapDen=0;
  for(let i=0;i<len;i++){
    const mid=(parseFloat(klines[i][1])+highs[i]+lows[i]+closes[i])/4;
    const w=lows[i]<=low30pct?vols[i]*2:vols[i]*0.5;
    vwapNum+=mid*w;vwapDen+=w;
  }
  const vwap=vwapDen>0?vwapNum/vwapDen:closes[len-1];
  const low60=Math.min(...lows.slice(-60));
  const high60=Math.max(...highs.slice(-60));

  return{
    costLow:low60*1.02,
    costMid:vwap,
    costHigh:low60*1.35,
    low60,high60,vwap,
    targets:[
      {label:'보수 목표',mult:3, pct:200},
      {label:'중간 목표',mult:5, pct:400},
      {label:'공격 목표',mult:10,pct:900},
      {label:'극단 목표',mult:20,pct:1900},
    ]
  };
}


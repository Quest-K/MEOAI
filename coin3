// ── MAIN ──
async function analyze(){
  let sym=$('symInput').value.trim().toUpperCase();
  if(!sym){$('symInput').focus();return;}
  if(!sym.endsWith('USDT'))sym=sym.replace(/USDT$/,'')+'USDT';

  $('dot').className='dot loading';
  $('statusTxt').textContent='분석 중...';
  $('analyzeBtn').disabled=true;
  $('emptyState').style.display='none';
  $('result').classList.remove('show');

  try{
    const[klines,ticker,oi]=await Promise.all([
      fetchKlines(sym,'1d',200),
      fetchTicker(sym),
      fetchOI(sym),
    ]);
    if(klines.length<30)throw new Error('데이터 부족 (최소 30일 필요)');

    const analysis=detectStage(klines);
    const cost=estimateCost(klines);
    const moves=getNextMoves(analysis.stageIdx);
    const st=STAGES[analysis.stageIdx];

    const cur=parseFloat(ticker.lastPrice);
    const chgPct=parseFloat(ticker.priceChangePercent);
    const vol24h=parseFloat(ticker.volume);
    const high24h=parseFloat(ticker.highPrice);
    const low24h=parseFloat(ticker.lowPrice);
    const oiVal=oi?oi*cur:null;

    renderSymHeader(sym,cur,chgPct,high24h,low24h,vol24h,oiVal);
    renderPipeline(analysis.stageIdx);
    renderMainGrid(analysis,st);
    renderLevels(cost,cur);
    renderProfit(cost,cur,analysis.stageIdx);
    renderNext(moves);

    $('result').classList.add('show');
    $('dot').className='dot done';
    $('statusTxt').textContent=`${sym} 분석 완료`;
  }catch(e){
    $('dot').className='dot';
    $('statusTxt').textContent='오류: '+e.message;
    $('emptyState').style.display='flex';
    $('emptyState').querySelector('.empty-title').textContent='분석 실패';
    $('emptyState').querySelector('.empty-sub').innerHTML=
      e.message+'<br><br><span style="color:var(--b3)">USDT 선물에 없는 심볼이거나 오타일 수 있어요</span>';
  }
  $('analyzeBtn').disabled=false;
}

